# ---------------------------------------------------------------------------
# invoice-to-payment-agent - example environment
# Copy to .env and adjust. Every setting is optional; the defaults below are
# what the application falls back to when the variable is absent.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
INVOICE_AGENT_ENVIRONMENT=local
INVOICE_AGENT_API_PREFIX=/api/v1
INVOICE_AGENT_DOCUMENT_STORE=data/documents

# Auth is off by default so a local run needs no headers. Turn it on before
# exposing the service anywhere shared, and change the token.
INVOICE_AGENT_AUTH_ENABLED=false
INVOICE_AGENT_API_TOKEN=local-dev-token
INVOICE_AGENT_CORS_ORIGINS=["*"]

# --- postgres + pgvector ---------------------------------------------------
INVOICE_AGENT_DB_HOST=localhost
INVOICE_AGENT_DB_PORT=5432
INVOICE_AGENT_DB_USER=invoice
INVOICE_AGENT_DB_PASSWORD=invoice
INVOICE_AGENT_DB_NAME=invoice_agent
INVOICE_AGENT_DB_POOL_SIZE=10
INVOICE_AGENT_DB_MAX_OVERFLOW=20
INVOICE_AGENT_DB_ECHO=false

# --- ollama ----------------------------------------------------------------
# embedding_dim must match the embedding model: nomic-embed-text is 768.
# Changing the model without changing the dimension breaks the pgvector tables.
INVOICE_AGENT_LLM_BASE_URL=http://localhost:11434
INVOICE_AGENT_LLM_MODEL=llama3.1:8b
INVOICE_AGENT_LLM_EMBEDDING_MODEL=nomic-embed-text
INVOICE_AGENT_LLM_EMBEDDING_DIM=768
INVOICE_AGENT_LLM_TEMPERATURE=0.0
INVOICE_AGENT_LLM_REQUEST_TIMEOUT=180
INVOICE_AGENT_LLM_NUM_CTX=8192
INVOICE_AGENT_LLM_MAX_EXTRACTION_RETRIES=2

# --- mailbox ---------------------------------------------------------------
# local = read samples/inbox from disk, no credentials needed.
# graph = Microsoft Graph (shared mailbox). gmail = Gmail API.
INVOICE_AGENT_MAILBOX_PROVIDER=local
INVOICE_AGENT_MAILBOX_LOCAL_ROOT=samples/inbox
INVOICE_AGENT_MAILBOX_POLL_INTERVAL_SECONDS=60
INVOICE_AGENT_MAILBOX_MAX_MESSAGES_PER_POLL=25
INVOICE_AGENT_MAILBOX_AP_FOLDER=Inbox
INVOICE_AGENT_MAILBOX_AR_FOLDER=Inbox
INVOICE_AGENT_MAILBOX_PROCESSED_LABEL=processed

# Microsoft Graph - app registration with Mail.Read application permission
INVOICE_AGENT_MAILBOX_GRAPH_TENANT_ID=
INVOICE_AGENT_MAILBOX_GRAPH_CLIENT_ID=
INVOICE_AGENT_MAILBOX_GRAPH_CLIENT_SECRET=
INVOICE_AGENT_MAILBOX_GRAPH_USER_PRINCIPAL_NAME=ap-inbox@example.com

# Gmail - OAuth client secrets downloaded from Google Cloud console
INVOICE_AGENT_MAILBOX_GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
INVOICE_AGENT_MAILBOX_GMAIL_TOKEN_FILE=credentials/gmail_token.json
INVOICE_AGENT_MAILBOX_GMAIL_QUERY=has:attachment newer_than:30d

# --- ERP -------------------------------------------------------------------
INVOICE_AGENT_ERP_BASE_URL=http://localhost:8081
INVOICE_AGENT_ERP_API_KEY=mock-erp-key
INVOICE_AGENT_ERP_TIMEOUT=30
INVOICE_AGENT_ERP_MAX_RETRIES=3
INVOICE_AGENT_ERP_COMPANY_CODE=1000
INVOICE_AGENT_ERP_DEFAULT_CURRENCY=EUR

# --- matching tolerances ---------------------------------------------------
# Percentage tolerance applies to the unit price; the absolute tolerance
# applies to the extended line value (price delta x invoiced quantity).
INVOICE_AGENT_MATCH_PRICE_TOLERANCE_PCT=2.0
INVOICE_AGENT_MATCH_PRICE_TOLERANCE_ABS=5.00
INVOICE_AGENT_MATCH_QUANTITY_TOLERANCE_PCT=0.0
INVOICE_AGENT_MATCH_QUANTITY_TOLERANCE_ABS=0
INVOICE_AGENT_MATCH_TOTAL_TOLERANCE_PCT=1.0
INVOICE_AGENT_MATCH_TOTAL_TOLERANCE_ABS=10.00
INVOICE_AGENT_MATCH_TAX_TOLERANCE_ABS=1.00

# Segregation-of-duties ceiling: nothing above this posts without a human.
INVOICE_AGENT_MATCH_AUTO_POST_CEILING=25000.00
INVOICE_AGENT_MATCH_MIN_EXTRACTION_CONFIDENCE=0.75
INVOICE_AGENT_MATCH_VENDOR_MATCH_THRESHOLD=88
INVOICE_AGENT_MATCH_DUPLICATE_AMOUNT_TOLERANCE_ABS=0.01
INVOICE_AGENT_MATCH_REMITTANCE_TOLERANCE_ABS=2.00

# --- observability ---------------------------------------------------------
INVOICE_AGENT_OBS_ENABLED=true
INVOICE_AGENT_OBS_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
INVOICE_AGENT_OBS_PROJECT_NAME=invoice-to-payment-agent
INVOICE_AGENT_OBS_LOG_LEVEL=INFO
INVOICE_AGENT_OBS_JSON_LOGS=false

# --- mock ERP container ----------------------------------------------------
MOCK_ERP_API_KEY=mock-erp-key
MOCK_ERP_COMPANY_CODE=1000
